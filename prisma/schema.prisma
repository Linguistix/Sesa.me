// Sesame — link-in-bio platform
// Phase 1 (MVP): users, pages, links, themes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

/// A registered creator.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  image        String?
  plan         Plan     @default(FREE)
  locale       String   @default("fr")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pages        Page[]
  accounts     Account[]
  sessions     Session[]
  subscription  Subscription?
  aiGenerations AiGeneration[]

  @@map("users")
}

/// OAuth provider account linked to a user (Auth.js).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Database-backed session (Auth.js).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Email verification / password reset tokens (Auth.js).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// A public link-in-bio page. One page per slug.
model Page {
  id          String   @id @default(cuid())
  userId      String
  slug        String   @unique
  displayName String
  bio         String?  @db.Text
  avatarUrl   String?
  /// Serialized Theme object — validated against the theme schema before write.
  themeJson   Json
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  links      Link[]
  events     AnalyticsEvent[]
  shortLinks ShortLink[]

  @@index([userId])
  @@map("pages")
}

enum LinkType {
  LINK
  HEADING
  TEXT
  SOCIAL
}

/// A block on a page. `position` orders blocks ascending.
model Link {
  id           String   @id @default(cuid())
  pageId       String
  type         LinkType @default(LINK)
  title        String
  url          String?
  emoji        String?
  iconUrl      String?
  /// Free-text body for TEXT blocks.
  body         String?  @db.Text
  position     Int
  isActive     Boolean  @default(true)
  /// bcrypt hash — when set, the destination is gated behind a password.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  page       Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  events     AnalyticsEvent[]
  shortLinks ShortLink[]

  @@index([pageId, position])
  @@map("links")
}

// --- Phase 2: analytics, short links, subscriptions ------------------------

enum EventType {
  PAGE_VIEW
  LINK_CLICK
}

/// A single analytics event.
///
/// Deliberately append-only and denormalised: writes are on the hot path of
/// every public page view, so they must never wait on a join or an update.
/// Dashboard figures are aggregated from here with grouped queries, and the
/// table is a natural candidate for monthly range partitioning on `createdAt`
/// once volume warrants it (see `docs/analytics.md`).
model AnalyticsEvent {
  id        String    @id @default(cuid())
  pageId    String
  linkId    String?
  type      EventType
  createdAt DateTime  @default(now())

  /// Referrer host only ("instagram.com"), never the full referring URL.
  source  String?
  /// ISO 3166-1 alpha-2, from the CDN's geo header.
  country String?
  /// "mobile" | "tablet" | "desktop"
  device  String?

  /// Rotating daily hash of IP + user agent. Lets us count unique visitors
  /// without ever storing an IP address, and it stops being linkable to the
  /// same person after 24h. See `src/lib/analytics/visitor.ts`.
  visitorHash String?

  page Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  link Link? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
  @@index([linkId, createdAt])
  @@index([pageId, type, createdAt])
  @@map("analytics_events")
}

/// A short URL served from `/u/<code>`.
model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique
  pageId    String
  linkId    String?
  targetUrl String
  createdAt DateTime @default(now())

  page Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  link Link? @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("short_links")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

/// Mirror of the Stripe subscription that grants a user the Pro plan.
///
/// `User.plan` stays the single source of truth the rest of the app reads;
/// this row records why it has that value and lets the webhook be idempotent.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus
  plan                 Plan               @default(PRO)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// --- Phase 3: AI design engine --------------------------------------------

enum AiGenerationKind {
  THEME
  ANALYTICS_SUMMARY
}

/// Log of every AI call.
///
/// Serves two jobs the design brief calls for. It is the quota ledger — free
/// plans are capped per calendar month, and counting rows is the cheapest
/// honest way to enforce that. It is also the corpus for tuning the system
/// prompt: `prompt` and `output` are kept so a bad generation can be traced
/// back to what the model was actually asked.
model AiGeneration {
  id     String           @id @default(cuid())
  userId String
  kind   AiGenerationKind @default(THEME)

  /// The user's natural-language description, as typed.
  prompt String @db.Text
  /// Raw model output, before validation. Null when the call failed.
  output String? @db.Text

  /// Whether the output failed schema validation and fell back to a default.
  usedFallback Boolean @default(false)
  /// Contrast pairs that had to be corrected after generation.
  fixesApplied Int     @default(0)

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  /// Set when the call itself failed, so failures are visible in the log too.
  error String? @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("ai_generations")
}
