# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/sesame?schema=public"

# --- Auth (Auth.js) -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# --- Public URL used for QR codes, short links and absolute metadata ------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Analytics ------------------------------------------------------------
# Server-side salt for the daily-rotating visitor hash. Rotating it resets
# unique-visitor counts but breaks nothing.
ANALYTICS_SALT=""

# --- Stripe (optional — billing is disabled when unset) -------------------
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# --- AI design engine (optional — AI features disabled when unset) --------
# Powers theme generation and the weekly analytics summary.
ANTHROPIC_API_KEY=""

# --- Redis (optional — falls back to per-process memory when unset) -------
# Shares rate-limit counters and the public-page cache across instances.
# Required for correct limits on a multi-instance deployment.
REDIS_URL=""

# --- Object storage (optional — image fields accept URLs when unset) ------
# S3-compatible: works with Cloudflare R2, Backblaze B2, MinIO or S3 itself.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""          # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""        # CDN or custom domain in front of the bucket
# The bucket MUST allow CORS for PUT from the app's origin, or every direct
# upload fails at the browser's preflight. See docs/storage.md.
