# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/sesame?schema=public"

# --- Auth (Auth.js) -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# --- Public URL used for QR codes, short links and absolute metadata ------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Analytics ------------------------------------------------------------
# Server-side salt for the daily-rotating visitor hash. Rotating it resets
# unique-visitor counts but breaks nothing.
ANALYTICS_SALT=""

# --- Stripe (optional — billing is disabled when unset) -------------------
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# --- AI design engine (optional — AI features disabled when unset) --------
# Powers theme generation and the weekly analytics summary.
ANTHROPIC_API_KEY=""
